{
  "name": "botc-solo-simulator",
  "version": "0.2.0",
  "description": "Blood on the Clocktower single-player simulator",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:start": "electron .",
    "electron:win": "electron-builder --win nsis",
    "electron:pack": "electron-builder --win --dir",
    "test:role-actions": "node tests/role_action_contracts.mjs",
    "test:passive-info-queues": "node tests/passive_info_storyteller_queue_contracts.mjs",
    "test:night-actions": "node tests/night_action_completeness_contracts.mjs",
    "test:full-game-loop": "node tests/full_game_loop_contracts.mjs",
    "test:ai-agents": "node tests/ai_agent_contracts.mjs",
    "test:ai-quality-eval": "node tests/ai_quality_eval_contracts.mjs",
    "test:ai-llm-renderer": "node tests/ai_llm_renderer_contracts.mjs",
    "test:ai-llm-dialogue-eval": "node tests/ai_llm_dialogue_eval_contracts.mjs",
    "test:unity-private-chat-semantic": "node tests/unity_private_chat_semantic_contracts.mjs",
    "test:electron-build": "node tests/electron_build_contracts.cjs",
    "test:electron-paths": "node tests/electron_path_contracts.cjs",
    "test:unity-viewmodel": "node tests/unity_viewmodel_contracts.mjs",
    "test:unity-action-bridge": "node tests/unity_action_bridge_contracts.mjs",
    "test:unity-playable-path": "node scripts/unity_playable_path_smoke.mjs",
    "test:unity-csharp-smoke": "powershell -ExecutionPolicy Bypass -File tools/unity_csharp_compile_smoke.ps1",
    "test:unity-demo-acceptance": "node scripts/unity_demo_acceptance.mjs",
    "test:unity-assets": "node tests/unity_asset_contracts.mjs && node scripts/sync_unity_assets.mjs --check",
    "test:unity-ui-audio": "node tests/unity_ui_audio_regression_contracts.mjs",
    "test:mojibake": "node tests/mojibake_contracts.mjs",
    "ai:dialogue-smoke": "node scripts/ai_dialogue_smoke.mjs",
    "ai:llm-render-smoke": "node scripts/ai_llm_render_smoke.mjs --mock",
    "ai:llm-dialogue-eval": "node scripts/ai_llm_dialogue_eval.mjs --mock",
    "ai:llm-dialogue-eval:live": "node scripts/ai_llm_dialogue_eval.mjs --live --provider=ollama --timeout=30000",
    "ai:llm-sft-dataset": "node scripts/build_llm_sft_dataset.mjs",
    "ai:llm-sft-dataset:rendered": "node scripts/build_llm_sft_dataset.mjs --target=rendered --provider=mock",
    "export:unity-viewmodel": "node scripts/export_unity_viewmodel.mjs",
    "unity:sync-assets": "node scripts/sync_unity_assets.mjs",
    "unity:sync-build-core": "node scripts/sync_unity_build_core.mjs",
    "test:unity-build-core-sync": "node scripts/sync_unity_build_core.mjs --check",
    "test:unity-build-self-start": "powershell -ExecutionPolicy Bypass -File tools/unity_build_self_start_smoke.ps1",
    "test:unity-build-self-start-matrix": "powershell -ExecutionPolicy Bypass -File tools/unity_build_self_start_matrix_smoke.ps1",
    "test:unity-build-click-smoke": "powershell -ExecutionPolicy Bypass -File tools/unity_build_click_smoke.ps1",
    "test:unity-build-submit-night-action": "powershell -ExecutionPolicy Bypass -File tools/unity_build_submit_night_action_smoke.ps1",
    "test:unity-build-submit-storyteller-action": "powershell -ExecutionPolicy Bypass -File tools/unity_build_submit_storyteller_action_smoke.ps1",
    "test:unity-build-storyteller-gate-matrix": "powershell -ExecutionPolicy Bypass -File tools/unity_build_storyteller_gate_matrix_smoke.ps1",
    "test:unity-status": "powershell -ExecutionPolicy Bypass -File tools/unity_status_smoke.ps1",
    "test:unity-build-watch-night-actions": "powershell -ExecutionPolicy Bypass -File tools/unity_build_watch_night_actions_smoke.ps1",
    "test:unity-playable-demo": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ExternalBridge -StopAfterFirstNightAction",
    "test:unity-playable-day-action": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ScriptId tb -Role slayer -AutoFlow -ResolveFirstDayAction",
    "test:unity-playable-human-nomination": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ResolveFirstHumanNomination",
    "test:unity-playable-human-nomination-pass": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ResolveFirstHumanNomination -PassAfterHumanNominationVote",
    "test:unity-playable-guided-cycle": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ResolveFirstHumanNomination -PassAfterHumanNominationVote -ResolveNextNightAfterHumanNominationPass",
    "test:unity-playable-player-decision": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -AutoFlow -StopAtNominationDebate",
    "test:unity-playable-player-resume": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -AutoFlow -ResolveFirstPlayerVote",
    "test:unity-playable-flow": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -AutoFlow -ResolveVotes -StopAfterDay 2",
    "test:unity-playable-endgame": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -AutoFlow -ResolveVotes -StopAtEndgame",
    "test:unity-playable-guided-endgame": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ExternalBridge -AutoFlow -ResolvePlayerDecisions -StopAtEndgame",
    "test:unity-playable-guided-endgame-matrix": "powershell -ExecutionPolicy Bypass -File tools/unity_playable_guided_endgame_matrix_smoke.ps1",
    "test:unity-playable-guided-high-risk-endgame-matrix": "powershell -ExecutionPolicy Bypass -File tools/unity_playable_guided_endgame_matrix_smoke.ps1 -IncludeHighRiskRoles",
    "test:unity-playable-guided-special-win-endgame-matrix": "powershell -ExecutionPolicy Bypass -File tools/unity_playable_guided_endgame_matrix_smoke.ps1 -IncludeSpecialWinRoles",
    "test:unity-playable-guided-special-event-endgame-matrix": "powershell -ExecutionPolicy Bypass -File tools/unity_playable_guided_endgame_matrix_smoke.ps1 -IncludeSpecialEventRoles",
    "test:unity-playable-guided-extended-endgame-matrix": "powershell -ExecutionPolicy Bypass -File tools/unity_playable_guided_endgame_matrix_smoke.ps1 -IncludeHighRiskRoles -IncludeSpecialWinRoles -IncludeSpecialEventRoles",
    "unity:playable": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ExternalBridge",
    "unity:playable:flow": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ExternalBridge -AutoFlow",
    "unity:playable:guided": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ExternalBridge -AutoFlow -ResolvePlayerDecisions",
    "unity:playable:endgame": "powershell -ExecutionPolicy Bypass -File tools/run_unity_playable_demo.ps1 -ExternalBridge -AutoFlow -ResolveVotes -StopAtEndgame",
    "unity:advance-flow": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --advance-flow",
    "unity:watch-flow": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --watch-flow",
    "unity:watch-guided": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --watch-flow --resolve-player-decisions",
    "unity:submit-day-action": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --day-action",
    "unity:submit-public-speech": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --public-speech",
    "unity:submit-nomination": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --nominate",
    "unity:submit-night-action": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets",
    "unity:pass-nomination": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --pass-nomination",
    "unity:submit-storyteller-action": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --storyteller-action",
    "unity:submit-vote": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --vote",
    "unity:status": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --status",
    "unity:watch-night-actions": "node scripts/submit_unity_night_action.mjs --streaming-assets=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets --watch",
    "unity:bridge": "node scripts/unity_action_bridge.mjs --watch",
    "unity:bridge:build": "node scripts/unity_action_bridge.mjs --watch --state=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets/unity_state.json --viewmodel=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets/unity_viewmodel.json --action=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets/unity_action.json --result=unity-build/BOTC_Unity_Prototype_Data/StreamingAssets/unity_action_result.json",
    "unity:demo:init": "node scripts/unity_action_bridge.mjs --fresh",
    "unity:demo": "powershell -ExecutionPolicy Bypass -File tools/run_unity_demo.ps1 -Fresh",
    "unity:ui-smoke": "powershell -ExecutionPolicy Bypass -File tools/capture_unity_ui_smoke.ps1",
    "unity:ui-smoke:verify": "powershell -ExecutionPolicy Bypass -File tools/verify_unity_ui_smoke.ps1",
    "unity:ui-smoke:verify:full": "powershell -ExecutionPolicy Bypass -File tools/verify_unity_full_ui_baseline.ps1",
    "prepare:local-llm": "powershell -ExecutionPolicy Bypass -File tools/prepare_local_llm.ps1",
    "prepare:local-llm:quality": "powershell -ExecutionPolicy Bypass -File tools/prepare_local_llm.ps1 -ModelTier quality -OutputDir third_party\\LocalLLM-quality",
    "prepare:local-llm:premium": "powershell -ExecutionPolicy Bypass -File tools/prepare_local_llm.ps1 -ModelTier premium -OutputDir third_party\\LocalLLM-premium",
    "prepare:local-llm:premium-max": "powershell -ExecutionPolicy Bypass -File tools/prepare_local_llm.ps1 -ModelTier premium-max -OutputDir third_party\\LocalLLM-premium-max",
    "package:unity-ai": "powershell -ExecutionPolicy Bypass -File tools/package_unity_ai_release.ps1",
    "package:unity-ai:embedded": "powershell -ExecutionPolicy Bypass -File tools/package_unity_ai_release.ps1 -PrepareLocalLlm -RequireLocalLlm",
    "package:unity-ai:embedded:verified": "powershell -ExecutionPolicy Bypass -File tools/package_unity_ai_release.ps1 -PrepareLocalLlm -RequireLocalLlm -VerifyPackage",
    "package:unity-ai:quality": "powershell -ExecutionPolicy Bypass -File tools/package_unity_ai_release.ps1 -PrepareLocalLlm -RequireLocalLlm -ModelTier quality -LocalLlmSource third_party\\LocalLLM-quality",
    "package:unity-ai:premium": "powershell -ExecutionPolicy Bypass -File tools/package_unity_ai_release.ps1 -PrepareLocalLlm -RequireLocalLlm -ModelTier premium -LocalLlmSource third_party\\LocalLLM-premium",
    "package:unity-ai:premium-max": "powershell -ExecutionPolicy Bypass -File tools/package_unity_ai_release.ps1 -PrepareLocalLlm -RequireLocalLlm -ModelTier premium-max -LocalLlmSource third_party\\LocalLLM-premium-max",
    "verify:unity-ai-package": "powershell -ExecutionPolicy Bypass -File tools/verify_unity_ai_package.ps1",
    "release:unity-ai:verified": "powershell -ExecutionPolicy Bypass -File tools/build_verify_unity_ai_release.ps1",
    "test": "npm run test:role-actions && npm run test:passive-info-queues && npm run test:night-actions && npm run test:full-game-loop && npm run test:ai-agents && npm run test:ai-quality-eval && npm run test:ai-llm-renderer && npm run test:ai-llm-dialogue-eval && npm run test:unity-private-chat-semantic && npm run test:electron-build && npm run test:electron-paths && npm run test:unity-viewmodel && npm run test:unity-action-bridge && npm run test:unity-assets && npm run test:unity-ui-audio && npm run test:unity-demo-acceptance && npm run test:mojibake"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.botc.solo",
    "productName": "BOTC Solo Simulator",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "assets/**/*",
      "scripts/**/*",
      "docs/research/UI_REFERENCE.md",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
